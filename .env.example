# Pipeline mode: "composable" (default — STT + LLM + TTS dials decide), or
# bundled "openai_realtime" / "gemini_live" / "hf_realtime" speech-to-speech
# handlers. When unset, derived from REACHY_MINI_AUDIO_INPUT_BACKEND +
# REACHY_MINI_AUDIO_OUTPUT_BACKEND. The admin UI persists this on save.
# REACHY_MINI_PIPELINE_MODE="composable"
# REACHY_MINI_AUDIO_INPUT_BACKEND="moonshine"
# REACHY_MINI_AUDIO_OUTPUT_BACKEND="chatterbox"
# Optional model override for OpenAI Realtime / Gemini Live.
# MODEL_NAME="gpt-realtime"

# Set up your API key according to your backend
OPENAI_API_KEY=
# GEMINI_API_KEY=

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Head-tracking backend: "mediapipe" (default), "yolo", or "off" to disable.
# Mediapipe runs in-process and is on by default. Set to "off" to disable without
# touching CLI flags. Set to "yolo" to use the YOLO face detector instead (requires yolo_vision extra).
# REACHY_MINI_HEAD_TRACKER=off

# Greet tool: how often (seconds) to run MediaPipe face-detection inference
# during the face-scan poll loop when no face has been found yet.  Default 0.3 s
# (≈ 3 Hz) keeps CPU load low on a Pi 5 while still detecting faces promptly.
# Reduce toward 0.1 s for faster first-detection at the cost of higher CPU.
# REACHY_MINI_GREET_SCAN_POLL_INTERVAL_S=0.3

# Camera worker head-tracker idle poll rate.  When no face has been seen for
# the most recent frame the head-tracker drops to this rate (default 0.2 s /
# 5 Hz) instead of firing at 25 Hz.  The first frame with a face detected
# immediately resets back to full rate.  Increase to reduce idle CPU at the
# cost of slightly slower initial face-lock-on.  Floor is 0.04 s (one frame).
# REACHY_MINI_HEAD_TRACKER_IDLE_POLL_INTERVAL_S=0.2

# Local vision model (only used with --local-vision CLI flag)
# By default, vision is handled by the selected realtime backend when the camera tool is used
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Local speech-to-text options, used on the composable pipeline path.
# Requires the local_stt extra to be installed. Speech recognition runs on-device;
# finalized text is sent to the selected TTS output backend.
# LOCAL_STT_PROVIDER=moonshine
# LOCAL_STT_CACHE_DIR=./cache/moonshine_voice
# LOCAL_STT_LANGUAGE=en
# LOCAL_STT_MODEL=tiny_streaming
# LOCAL_STT_UPDATE_INTERVAL=0.35

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=house_comedian

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not listed in the selected profile's tools.txt.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

